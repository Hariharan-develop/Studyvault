# ==============================================================================
# StudyVault AI – Environment Variables
#
# Note: Firebase configuration is already fully loaded from firebase-applet-config.json.
# The only external environment variable required by the backend is GEMINI_API_KEY.
# ==============================================================================

# Gemini API Key (Required for all AI features: Study Chat, Smart Notes, Quiz, Planner)
GEMINI_API_KEY=your_gemini_api_key
